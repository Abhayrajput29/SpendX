# ==============================================================================
# FinanceAI / SpendX - Production Environment Variables Template
# Copy this file to .env locally or set these in your Vercel Project Settings:
# Project Settings -> Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=production

# Server Port (Local development only; ignored on Vercel Serverless)
PORT=5001

# MongoDB Connection String (Required for production multi-user persistence)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/spendx?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/spendx?retryWrites=true&w=majority

# MongoDB Connection Timeout in milliseconds
MONGODB_TIMEOUT_MS=5000

# Google Gemini API Key (For receipt OCR scanning & AI Financial Advisor)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (gemini-1.5-flash or gemini-2.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Secret key used to sign and verify JWT authentication tokens
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_jwt_secret_key_here

# Fallback Admin Password for emergency/development login
APP_PASSWORD=YourStrongPasswordHere!

# Optional: Allowed CORS origin (Defaults to true/all origins for preview deployments)
# Example: https://your-domain.vercel.app
CLIENT_ORIGIN=
