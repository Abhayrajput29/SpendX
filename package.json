{
  "name": "finance-ai-monorepo",
  "version": "1.0.0",
  "description": "AI Expense Tracker with OCR, auto-categorization and budgeting",
  "main": "server/server.js",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build:client",
    "build:client": "cd client && npm run build",
    "install:all": "npm install && npm run install:server && npm run install:client",
    "install:server": "cd server && npm install --legacy-peer-deps",
    "install:client": "cd client && npm install --legacy-peer-deps",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "npm run build:client && NODE_ENV=production node server/server.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.4.1",
    "multer": "^2.3.0",
    "tesseract.js": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
