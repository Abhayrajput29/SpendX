# Required for signing in to the local single-user workspace
APP_PASSWORD=
AUTH_SECRET=

# Optional: defaults to the local database below
MONGODB_URI=mongodb://127.0.0.1:27017/expense_tracker

# Optional: explicitly allow local JSON storage if a configured remote database is unreachable
SPENDX_JSON_FALLBACK=false

# Optional: enables Gemini-powered features
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: defaults to 5001
PORT=5001
CRON_SECRET=

# Optional: comma-separated browser origins when the frontend and API use different domains
CLIENT_ORIGIN=
